BOT_TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id

# Public guild replies by default. Discord may still force private responses
# for user-installed apps when the member lacks Use External Apps permission.
PUBLIC_REPLIES_IN_GUILDS=true

# Hard cap stays at 500MB because Discord does not allow larger uploads.
MAX_DOWNLOAD_SIZE=500mb

# Workload controls for a public bot.
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=50
MAX_CONCURRENT_JOBS_PER_USER=1

# Timeouts must remain under Discord's interaction token lifetime.
HTTP_RESPONSE_TIMEOUT_MS=45000
HTTP_IDLE_TIMEOUT_MS=60000
YTDLP_TIMEOUT_MS=480000
FFMPEG_TIMEOUT_MS=600000
JOB_TIMEOUT_MS=840000
DISCORD_REST_TIMEOUT_MS=180000
DISCORD_REST_RETRIES=0

# Keep uploads below Discord's advertised limit when the route is too slow to
# finish a near-limit attachment before an upstream 60-second connection cut.
DISCORD_UPLOAD_TARGET_SIZE=7mb
DISCORD_UPLOAD_ATTEMPTS=3
DISCORD_UPLOAD_RETRY_DELAY_MS=1500
STATUS_UPDATE_INTERVAL_MS=2500

# One Netscape-format cookie file can be shared by yt-dlp and gallery-dl.
# Export it from a browser profile; do not commit it.
MEDIA_COOKIES_FILE=

# Browser extraction is a local-development escape hatch. A cookie file is
# more reliable on servers and avoids Chrome lock/DPAPI failures on Windows.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PATH=
YTDLP_CONCURRENT_FRAGMENTS=4
YOUTUBE_JS_ENABLED=true
GALLERY_DL_ENABLED=true
GALLERY_DL_PATH=gallery-dl
DISABLED_ENGINES=

# Use your own Cobalt v11 instance. The Compose stack supplies
# http://cobalt:9000 inside the container network.
COBALT_API_ENDPOINTS=
COBALT_DIRECTORY_ENABLED=false
COBALT_DIRECTORY_URL=https://cobalt.directory/api/working?type=api
COBALT_ENDPOINT_TIMEOUT_MS=12000
COBALT_MAX_ENDPOINTS=3

# Optional, only if your chosen Cobalt instance requires one.
COBALT_API_KEY=
COBALT_AUTH_SCHEME=Api-Key

DEBUG=false
